{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "node",
    "lib": ["ES2022", "DOM"], "isolatedModules": true,
    "esModuleInterop": true, "allowJs": true, "checkJs": false,
    "baseUrl": ".", "paths": { "@windy/*": [
      "./node_modules/@windycom/plugin-devtools/types/*",
      "./node_modules/@windycom/plugin-devtools/types/client/*"
    ] }
  },
  "include": ["src/**/*"]
}
